# ==============================================================================
# Cloudflare Pages / Edge Function Environment Variables
# ==============================================================================
# Add these in Cloudflare Dashboard:
# Workers & Pages > amarmonchaise > Settings > Environment variables > Production / Preview
# ==============================================================================

# 1. Supabase Project URL (From Supabase > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Service Role Secret Key (Bypasses RLS for secure server-side checkout)
# CAUTION: Never expose this key in client-side code! Keep it server-side in Cloudflare only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Optional Telegram Order Alert Notification
# To get these:
# - Create bot via @BotFather to get TELEGRAM_BOT_TOKEN
# - Add bot to channel/group and get chat ID (or via @userinfobot) for TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890
